{
  "projectName": "MyAutoApp",
  "srcDir": "../src",
  "testDir": "../src",
  "fileExtensions": [".js", ".ts", ".jsx", ".tsx"],
  "ignorePaths": ["node_modules", "android", "ios", ".git", "dist"],
  "llm": {
    "provider": "ollama",
    "model": "qwen2.5-coder:7b",
    "fastModel": "qwen2.5-coder:1.5b",
    "strategy": "balanced"
  },
  "git": {
    "mode": "branch",
    "compareBranch": "main"
  },
  "jest": {
    "command": "npx jest",
    "args": ["--passWithNoTests"],
    "rootDir": ".."
  }
}
